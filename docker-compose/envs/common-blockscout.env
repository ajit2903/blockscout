https://github.com/blockscout/blockscout/blob/master/docker-compose%2Fenvs%2Fcommon-blockscout.env
ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_HTTP_URL=${ETHEREUM_RPC_URL}
ETHEREUM_JSONRPC_TRACE_URL=${ETHEREUM_RPC_URL}
ETHEREUM_JSONRPC_TRANSPORT=http
DISABLE_FILE_LOGGING=false
DATABASE_URL=${DATABASE_URL}
CHAIN_TYPE=ethereum
APPLICATION_MODE=all
DISABLE_INDEXER=false
DISABLE_REALTIME_INDEXER=false
DISABLE_CATCHUP_INDEXER=false
PORT=4000
POOL_SIZE=80
POOL_SIZE_API=10
ECTO_SSL_MODE=disable
ECTO_USE_SSL=false
DISABLE_MARKET=true
ADMIN_PANEL_ENABLED=false
API_V1_READ_METHODS_DISABLED=false
API_V1_WRITE_METHODS_DISABLED=false
INDEXER_BEACON_DEPOSIT_FETCHER_WALLET_ADDRESSES=0x06EE840642a33367ee59fCA237F270d5119d1356
INDEXER_BEACON_RPC_URL=https://ethereum-beacon-api.publicnode.com

